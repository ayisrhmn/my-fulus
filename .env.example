# Postgres (shared DB). DB_SCHEMA is applied as the search_path.
DATABASE_URL=postgres://user:password@host:5432/dbname
DB_SCHEMA=myfulus

# Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

AUTH_SECRET=

# Public site URL for SEO/OG tags (optional; Vercel domain is auto-detected in prod)
NEXT_PUBLIC_SITE_URL=
